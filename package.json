{
  "name": "huanglong-poi-route-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "澄路：黄龙景区移动端 POI 推荐、设施地图与游线规划原型",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:water": "node scripts/build-water-scene.mjs",
    "start": "node server.js",
    "test": "node --test tests/*.test.cjs",
    "build:cloudflare": "node scripts/build-water-scene.mjs && node scripts/build-cloudflare.cjs",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy --keep-vars",
    "refresh:facilities": "node scripts/refresh-facilities.cjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "three": "0.180.0",
    "wrangler": "4.127.1"
  }
}
