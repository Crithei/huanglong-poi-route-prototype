{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "huanglong-route",
  "account_id": "d6b6e8bbac724daddec12141addc8da3",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "routes": [],
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/runtime-config.js", "/_AMapService/*"],
    "not_found_handling": "none"
  },
  "observability": { "enabled": false }
}
